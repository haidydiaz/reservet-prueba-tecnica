# Copia este archivo a .env (no se sube a Git) y ajusta los valores a tu instalación.
PORT=3000
# PostgreSQL instalado directamente suele usar el puerto 5432 (el compose de Docker usa 5433).
# Codifica en URL los caracteres especiales de la contraseña.
DATABASE_URL=postgresql://reservet_candidate:local_candidate_password@localhost:5432/reservet_candidate

# Base EXCLUSIVA para pruebas de integración. Su nombre debe terminar en _test:
# las pruebas vacían sus tablas y se niegan a correr contra cualquier otra base.
TEST_DATABASE_URL=postgresql://reservet_candidate:local_candidate_password@localhost:5432/reservet_candidate_test

# Autenticación (todas opcionales)
# Horas que dura una sesión antes de caducar sola (por defecto 8).
SESSION_TTL_HOURS=8
# La cookie de sesión lleva el atributo Secure. Por defecto: true si APP_ENV=pro, false en dev.
# COOKIE_SECURE=false

# Usuario de prueba para `npm run db:seed`. Elige tu propia contraseña local (mínimo 8 caracteres)
# y no la reutilices en ningún otro sitio.
SEED_USERNAME=encargado
SEED_PASSWORD=cambia-esta-contrasena-local
